DATABASE_URL="postgresql://user:password@localhost:5432/task_manager?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"
PORT=3000
NODE_ENV=development
# Offset (minutos respecto a UTC) de la zona horaria del negocio, usado solo
# al importar horas desde Excel (Colombia = -300).
IMPORT_TZ_OFFSET_MINUTES=-300
